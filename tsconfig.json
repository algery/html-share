{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "vitest.config.ts",
    "packages/**/*.d.ts",
    "packages/**/*.test.ts",
    "packages/**/*.spec.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
