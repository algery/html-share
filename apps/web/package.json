{
  "name": "@html-share/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node ../../scripts/run-with-example-env.mjs ./node_modules/next/dist/bin/next dev",
    "build": "node ../../scripts/run-with-example-env.mjs ./node_modules/next/dist/bin/next build --webpack",
    "start": "node .next/standalone/apps/web/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@html-share/config": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.0"
  }
}
