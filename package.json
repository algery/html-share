{
  "name": "html-share",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm db:generate && pnpm build:packages && pnpm build:apps",
    "build:apps": "pnpm --filter './apps/**' run --if-present build",
    "build:packages": "pnpm --filter './packages/**' run --if-present build",
    "dev": "pnpm stack:up",
    "dev:dingtalk": "pnpm build:packages && pnpm dev:apps:dingtalk",
    "dev:apps": "pnpm build:packages && pnpm dev:apps:parallel",
    "dev:apps:dingtalk": "pnpm --filter './apps/**' run --parallel --stream --if-present dev:dingtalk",
    "dev:apps:parallel": "pnpm --filter './apps/**' run --parallel --stream --if-present dev",
    "db:generate": "node scripts/database-generate.mjs",
    "db:migrate:deploy": "node --env-file=.env.example scripts/database-migrate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "health": "node --env-file=.env.example scripts/health-check.mjs",
    "infra:down": "docker compose --env-file .env.example down",
    "infra:up": "docker compose --env-file .env.example up -d --wait postgres minio",
    "lint": "eslint . --max-warnings 0",
    "load:phase9:upload:local": "node scripts/phase9-upload-capacity.mjs",
    "security:check": "node scripts/check-secret-hygiene.mjs --workspace",
    "skills:package": "node skills/build-distributions.mjs",
    "smoke:phase2": "node scripts/phase2-smoke.mjs",
    "smoke:phase3": "node scripts/phase3-smoke.mjs",
    "smoke:phase4": "node scripts/phase4-smoke.mjs",
    "smoke:phase5": "node scripts/phase5-smoke.mjs",
    "smoke:phase6": "node scripts/phase6-smoke.mjs",
    "smoke:phase7": "vitest run apps/server/src/phase7.test.ts packages/db/src/project-reader.test.ts",
    "smoke:phase8": "node scripts/phase8-smoke.mjs",
    "smoke:phase9:migration": "node scripts/phase9-planb-migration-smoke.mjs",
    "test:browser:local": "playwright test",
    "test:phase9:atomic": "vitest run packages/db/src/upload-repository.integration.test.ts",
    "stack:up": "pnpm infra:up && pnpm db:migrate:deploy && docker compose --env-file .env.example up -d --build --wait",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && tsc -p tsconfig.json --noEmit && pnpm --filter './apps/**' --filter './packages/**' run --if-present typecheck",
    "smoke:password-access:migration": "node scripts/password-access-migration-smoke.mjs",
    "smoke:password-management:migration": "node scripts/password-management-migration-smoke.mjs",
    "smoke:password-management": "node scripts/password-management-smoke.mjs",
    "smoke:password-publication": "node scripts/password-publication-smoke.mjs",
    "smoke:password-access": "node scripts/password-access-smoke.mjs",
    "smoke:password-skill": "node scripts/password-skill-smoke.mjs",
    "smoke:password-capacity": "node scripts/password-capacity-smoke.mjs",
    "smoke:password-k6": "node scripts/password-k6-smoke.mjs",
    "smoke:password-security": "node scripts/password-security-smoke.mjs",
    "smoke:password-proxy": "node scripts/password-proxy-smoke.mjs --exclusive-window",
    "smoke:password-image": "node scripts/password-image-smoke.mjs",
    "smoke:password-main": "node scripts/password-main-smoke.mjs",
    "db:schema:check": "node scripts/database-schema-check.mjs",
    "db:smoke": "node scripts/database-smoke.mjs",
    "db:test:integration": "node scripts/database-integration-check.mjs",
    "db:upgrade:smoke": "node scripts/database-upgrade-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.0"
  }
}
