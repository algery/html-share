# Public browser configuration (never place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
NEXT_PUBLIC_DEMO_URL=http://demo.localhost:3001
NEXT_PUBLIC_API_URL=http://app.localhost:3001
NEXT_PUBLIC_DINGTALK_CLIENT_ID=dingpjb5vdsdioh3d9gc
NEXT_PUBLIC_DINGTALK_CORP_ID=ding70f1294c5e5ace16f2c783f7214b6d69

# API server and worker
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
APP_HOST=app.localhost
DEMO_HOST=demo.localhost
APP_AUTH_URL=http://app.localhost:3001
DEMO_AUTH_URL=http://demo.localhost:3001
APP_WEB_URL=http://app.localhost:3000
DEMO_WEB_URL=http://demo.localhost:3001
AUTH_STATE_SECRET=local-development-state-signing-key-change-before-production
MCP_TOKEN_HASH_SECRET=local-development-mcp-token-hash-key-change-before-production
AUTH_RATE_LIMIT_PER_MINUTE=30
CONTENT_SESSION_RATE_LIMIT_PER_MINUTE=600
CONTENT_IP_RATE_LIMIT_PER_MINUTE=1200
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_UPLOAD_PREPARE_RATE_LIMIT_PER_MINUTE=10
MCP_UPLOAD_COMPLETE_RATE_LIMIT_PER_MINUTE=10
# Keep undefined for direct local development. Production trusts only the internal Caddy address.
TRUSTED_PROXY_IPS=
# Local simulator administrator only. Production must inject the reviewed administrator list through deployment secrets.
ADMIN_DINGTALK_USER_IDS=simulator-user-001
WORKER_HOST=127.0.0.1
WORKER_PORT=3002
UPLOAD_FINALIZATION_CONCURRENCY=10
UPLOAD_HEAD_OBJECT_TIMEOUT_MS=10000

# PostgreSQL 18 local development values (default; MySQL 8.4: .env.mysql.example)
POSTGRES_USER=html_share
POSTGRES_PASSWORD=html_share_local
POSTGRES_DB=html_share
POSTGRES_PORT=5432
# Omit only for legacy PostgreSQL deployments; explicit empty values are invalid.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://html_share:html_share_local@localhost:5432/html_share?schema=public
# The local Compose wrapper translates this exact local target for containers.
# Explicit remote URLs are kept; optionally set CONTAINER_DATABASE_URL for a
# different container route to the same instance. All three roles share it.
# DATABASE_PROVIDER/URL changes require restarting Server, Worker and migration.
# Selecting an empty target does not copy or clear the previous database.

# MinIO local development values
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=minio-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3-compatible private object storage; values match the MinIO settings above
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=html-share-local
OBJECT_STORAGE_ACCESS_KEY_ID=minio-local
OBJECT_STORAGE_ACCESS_KEY_SECRET=minio-local-secret

# DingTalk simulator is the only local default. Use live only after the callback
# allowlist is configured and inject the rotated secret through the deployment environment.
DINGTALK_AUTH_MODE=simulator
DINGTALK_APP_ID=6cd0d0c2-d301-4747-9944-37808e59b6dd
DINGTALK_CLIENT_ID=dingpjb5vdsdioh3d9gc
DINGTALK_CORP_ID=ding70f1294c5e5ace16f2c783f7214b6d69
# Kept blank for the simulator. Live deployments inject DINGTALK_CLIENT_SECRET
# from a secret manager; never place it in this file.
DINGTALK_CLIENT_SECRET=
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_EXTERNAL_AUTHORIZE_URL=https://login.dingtalk.com/oauth2/auth

# Synthetic local-only key; replace through runtime secrets in deployment.
PASSWORD_RESULT_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
PASSWORD_MANAGEMENT_ENCRYPTION_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=

# Independent password verification rate limits (requests per minute).
PASSWORD_VERIFY_IP_RATE_LIMIT_PER_MINUTE=60
PASSWORD_VERIFY_IP_PROJECT_RATE_LIMIT_PER_MINUTE=30
PASSWORD_VERIFY_PROJECT_RATE_LIMIT_PER_MINUTE=120
