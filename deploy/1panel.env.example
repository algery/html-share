# Copy this file to .env beside compose.1panel.yaml on the server. Never commit
# the real file. Restrict it to root with: chmod 600 .env

# Release controls. Change IMAGE_TAG for every release so rollback is explicit.
HTML_SHARE_IMAGE_TAG=2026-09-05.1
HTML_SHARE_PLATFORM=linux/amd64
HTML_SHARE_WEB_PORT=13000
HTML_SHARE_SERVER_PORT=13001
HTML_SHARE_SUBNET=172.31.240.0/24
# External Docker network used by applications installed through 1Panel.
HTML_SHARE_1PANEL_NETWORK=1panel-network

# Replace both example domains before building. NEXT_PUBLIC_* values are baked
# into the Web image, so a domain change requires rebuilding the web service.
APP_HOST=app.example.com
DEMO_HOST=demo.example.com
APP_AUTH_URL=https://app.example.com
APP_WEB_URL=https://app.example.com
DEMO_AUTH_URL=https://demo.example.com
DEMO_WEB_URL=https://demo.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_DEMO_URL=https://demo.example.com
NEXT_PUBLIC_API_URL=https://app.example.com

# DingTalk production application. Public values are also passed to the Web
# image build; CLIENT_SECRET must only appear in this server-side file.
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_EXTERNAL_AUTHORIZE_URL=https://login.dingtalk.com/oauth2/auth
DINGTALK_APP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
NEXT_PUBLIC_DINGTALK_CLIENT_ID=
NEXT_PUBLIC_DINGTALK_CORP_ID=
ADMIN_DINGTALK_USER_IDS=REPLACE_ME

# Relational database and private object storage. For a database installed by 1Panel,
# use its exact container name or network alias on HTML_SHARE_1PANEL_NETWORK.
# PostgreSQL 18 or MySQL 8.4 / InnoDB. Omission remains PostgreSQL for old env.
# MySQL URL format: mysql://USER:PASSWORD@db.example.com:3306/html_share
# Server/Worker/migration share these values. Restart all roles after changes.
# A different empty target does not inherit data: migrate existing data separately.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@1Panel-postgresql-vHO6:5432/html_share?schema=public
OBJECT_STORAGE_ENDPOINT=https://oss-cn-example.aliyuncs.com
OBJECT_STORAGE_PROVIDER=oss
OBJECT_STORAGE_REGION=cn-example
OBJECT_STORAGE_BUCKET=html-share-production
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_ME
OBJECT_STORAGE_ACCESS_KEY_SECRET=change-me

# Generate these independently with `openssl rand -hex 32`.
AUTH_STATE_SECRET=change-me
MCP_TOKEN_HASH_SECRET=change-me

# Only the 1Panel/OpenResty hop is trusted. If HTML_SHARE_SUBNET changes, replace
# 172.31.240.1 with the gateway of the new subnet as shown by docker network inspect.
TRUSTED_PROXY_IPS=127.0.0.1,172.18.0.1,172.31.240.0/24
UPLOAD_FINALIZATION_CONCURRENCY=10
UPLOAD_HEAD_OBJECT_TIMEOUT_MS=10000

# Required: independent Base64-encoded 32-byte runtime secret.
PASSWORD_RESULT_ENCRYPTION_KEY=
PASSWORD_MANAGEMENT_ENCRYPTION_KEY=

# Independent password verification rate limits (requests per minute).
PASSWORD_VERIFY_IP_RATE_LIMIT_PER_MINUTE=60
PASSWORD_VERIFY_IP_PROJECT_RATE_LIMIT_PER_MINUTE=30
PASSWORD_VERIFY_PROJECT_RATE_LIMIT_PER_MINUTE=120
# Maximum active Demos per account. The server reads this on startup.
MAX_DEMOS_PER_USER=100

# Project square selected audience: enable only after granting directory permissions.
# Simulator uses a synthetic directory. Live requires a same-company internal app.
DINGTALK_DIRECTORY_ENABLED=false
DINGTALK_CONTACT_API_BASE_URL=https://oapi.dingtalk.com

# Optional Feishu login: maps the configured Feishu tenant into this DingTalk app organization.
# Administrator-maintained phone/email are trusted for unique account matching.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
