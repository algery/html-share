# Copy to 1panel-build.local in the repository root. This file contains only
# public build-time values; never add server-side credentials here.
HTML_SHARE_IMAGE_TAG=2026-09-05.1
# x86_64 server: linux/amd64; aarch64 server: linux/arm64
HTML_SHARE_PLATFORM=linux/amd64
HTML_SHARE_DATABASE_HOST=1Panel-postgresql-vHO6

# These values are embedded into the browser bundle and must match production.
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_DEMO_URL=https://demo.example.com
NEXT_PUBLIC_API_URL=https://app.example.com
NEXT_PUBLIC_DINGTALK_CLIENT_ID=
NEXT_PUBLIC_DINGTALK_CORP_ID=
