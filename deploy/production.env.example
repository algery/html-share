# Copy outside the repository and inject real values through your secret manager.
APP_HOST=app.example.com
DEMO_HOST=demo.example.com
APP_AUTH_URL=https://app.example.com
APP_WEB_URL=https://app.example.com
DEMO_AUTH_URL=https://demo.example.com
DEMO_WEB_URL=https://demo.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_DEMO_URL=https://demo.example.com
NEXT_PUBLIC_API_URL=https://app.example.com
NEXT_PUBLIC_DINGTALK_CLIENT_ID=
NEXT_PUBLIC_DINGTALK_CORP_ID=
# PostgreSQL 18 or MySQL 8.4 / InnoDB. Omission remains PostgreSQL for old env.
# MySQL URL format: mysql://USER:PASSWORD@db.example.com:3306/html_share
# Server/Worker/migration share these values. Restart all roles after changes.
# A different empty target does not inherit data: migrate existing data separately.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/html_share?schema=public
OBJECT_STORAGE_ENDPOINT=https://oss-cn-example.aliyuncs.com
OBJECT_STORAGE_PROVIDER=oss
OBJECT_STORAGE_REGION=cn-example
OBJECT_STORAGE_BUCKET=html-share-production
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY_SECRET=
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_EXTERNAL_AUTHORIZE_URL=https://login.dingtalk.com/oauth2/auth
DINGTALK_APP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
AUTH_STATE_SECRET=
MCP_TOKEN_HASH_SECRET=
ADMIN_DINGTALK_USER_IDS=
# Static address of the Caddy container on the internal application network.
TRUSTED_PROXY_IPS=172.30.0.10
# One Worker claims this many independent uploads concurrently; deployment resources match this cap.
UPLOAD_FINALIZATION_CONCURRENCY=10
UPLOAD_HEAD_OBJECT_TIMEOUT_MS=10000

# Required: independent Base64-encoded 32-byte runtime secret.
PASSWORD_RESULT_ENCRYPTION_KEY=
PASSWORD_MANAGEMENT_ENCRYPTION_KEY=

# Independent password verification rate limits (requests per minute).
PASSWORD_VERIFY_IP_RATE_LIMIT_PER_MINUTE=60
PASSWORD_VERIFY_IP_PROJECT_RATE_LIMIT_PER_MINUTE=30
PASSWORD_VERIFY_PROJECT_RATE_LIMIT_PER_MINUTE=120

# Project square selected audience: enable only after granting directory permissions.
# Simulator uses a synthetic directory. Live requires a same-company internal app.
DINGTALK_DIRECTORY_ENABLED=false
DINGTALK_CONTACT_API_BASE_URL=https://oapi.dingtalk.com
